# Salin file ini menjadi .env.local dan isi dengan nilai proyek Supabase aplikasi santri.
# JANGAN pernah mengisi nilai asli ke file contoh ini.

# URL proyek Supabase (baru, terpisah dari Pustaka Ilmu)
NEXT_PUBLIC_SUPABASE_URL=

# Kunci anon/publishable proyek Supabase (aman dipakai di browser; akses data
# tetap dibatasi oleh Row Level Security di database)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
