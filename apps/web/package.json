    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@opennextjs/cloudflare": "1.20.16",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "jsdom": "31.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
